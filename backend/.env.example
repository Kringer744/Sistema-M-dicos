# Banco
DATABASE_URL=postgresql+asyncpg://medico:senha@postgres:5432/sistema_medico

# Redis
REDIS_URL=redis://redis:6379/0

# UazAPI (WhatsApp)
UAZAPI_BASE_URL=https://sua-instancia.uazapi.com
UAZAPI_ADMIN_TOKEN=cole_seu_admin_token_aqui
UAZAPI_TOKEN=                # preenchido automaticamente após criar a instância
UAZAPI_INSTANCE=clinica      # nome único da instância pra esse cliente

# LLM
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=anthropic/claude-haiku-4-5
LLM_FALLBACK_MODEL=openai/gpt-4o-mini

# Notificação da secretária
SECRETARIA_TELEFONE=5511999999999
NOTIFICAR_SECRETARIA=true

# Webhook
WEBHOOK_SECRET=troque_aqui

# JWT (painel admin)
JWT_SECRET=troque_aqui_use_openssl_rand
JWT_EXPIRE_HOURS=24

# Modo do processo (api | worker | both)
APP_MODE=both

# Timezone
TZ=America/Sao_Paulo

# Pós-venda
POSVENDA_HORA_DIARIA=9
